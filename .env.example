# SERA backend environment — copy to .env and fill in real values.
# Never commit the real .env (it is gitignored).

# Server
PORT=3001
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Required — auth token signing secret. Use a long random string.
# The server refuses to start without this (no insecure default).
JWT_SECRET=

# LLM (chat) — Groq, called via the OpenAI SDK
GROQ_API_KEY=

# RAG embeddings — Cohere
COHERE_API_KEY=

# Text-to-speech — ElevenLabs (optional; TTS disabled if unset)
ELEVENLABS_API_KEY=

# Google OAuth — client ID is public; secret is not required for the
# access-token/ID-token verification flow currently used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB — optional; the server runs without a DB if unset
MONGODB_URI=
MONGODB_DB=aisexdoc
