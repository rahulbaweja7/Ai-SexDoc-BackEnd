{
  "meta": {
    "description": "SERA golden evaluation set. Each item ties a user-style question to the corpus chunk ids (see corpus.json) that SHOULD be retrieved, plus key facts that must appear in a faithful answer.",
    "schema": {
      "id": "unique question id",
      "question": "user-style natural language question",
      "topic": "corpus topic tag",
      "type": "factual | lay_paraphrase | multi_hop | out_of_scope",
      "expected_source_ids": "corpus chunk ids that should be retrieved (empty for out_of_scope)",
      "key_facts": "substrings/claims a correct grounded answer should contain",
      "expected_behavior": "answer (default) | decline_or_no_source (for out_of_scope / not-in-corpus)"
    },
    "corpus_ref": "corpus.json",
    "count": 40
  },
